{
  "name": "行迹 · GPX 卫星轨迹",
  "short_name": "行迹",
  "description": "把两步路、六只脚导出的 GPX 轨迹铺在卫星地图上回看",
  "lang": "zh-CN",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0e1116",
  "theme_color": "#0e1116",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "gpx", "accept": [".gpx", "application/gpx+xml", "application/xml", "text/xml", "application/octet-stream"] }] }
  },
  "file_handlers": [
    { "action": "./", "accept": { "application/gpx+xml": [".gpx"] } }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
